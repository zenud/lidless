#!/bin/bash
# lidless — keeps the Mac awake (lid closed included) for a set time, then restores sleep.
#   lidless          2 hours
#   lidless 4h       4 hours
#   lidless 90m      90 minutes
#   lidless noend    until "lidless stop" (or the low battery rule below)
#   lidless stop     ends the running session and restores sleep
#   lidless status   tells whether a session is running and whether the Mac slept during it
#
# On battery, a session ends by itself under $LOW % of charge, so the Mac goes
# to sleep instead of running flat and switching off.
#
# The command only writes the end time into $STATE. The service (this same
# script, run as root by launchd with "daemon") wakes up when that file changes
# and does the pmset work, which is why no password is needed here.

STATE=/var/db/lidless   # end of the session in epoch seconds, 0 when idle; read by the menu bar button
LOW=10                  # on battery, charge (%) under which a session ends
NOEND=9999999999        # end time of a session with no end (year 2286); the button knows it too
arg="${1:-2h}"

until_text() { [ "$1" = "$NOEND" ] && echo "until you stop it" || echo "until $(date -r "$1" '+%H:%M')"; }

low_battery() {
  local b; b=$(pmset -g batt)
  [[ "$b" == *"'Battery Power'"* && "$b" =~ ([0-9]+)% ]] && [ "${BASH_REMATCH[1]}" -lt "$LOW" ]
}

if [ "$arg" = daemon ]; then
  trap 'pmset -a disablesleep 0; exit' TERM   # service removed, or Mac shutting down
  while read -r end < "$STATE"; [[ "$end" =~ ^[0-9]{1,10}$ ]] && [ "$end" -gt "$(date +%s)" ]; do
    if low_battery; then echo 0 > "$STATE"; break; fi
    # Checked on every pass, not set once: anything else on the Mac can put
    # the setting back to 0 mid-session, and the button would not show it.
    pmset -g | grep -q 'SleepDisabled.*1' || pmset -a disablesleep 1
    sleep 5   # a stop or a new duration is picked up here
  done
  # Also reached at boot (RunAtLoad): puts sleep back after a crash mid-session.
  pmset -a disablesleep 0
  exit
fi

if [ ! -w "$STATE" ]; then
  echo "The lidless service is not installed: run ./install.sh" >&2
  exit 1
fi

if [ "$arg" = stop ]; then
  echo 0 > "$STATE"
  echo "Session ended, sleep is back."
  exit 0
fi

if [ "$arg" = status ]; then
  read -r end < "$STATE"
  if [[ ! "$end" =~ ^[0-9]{1,10}$ ]] || [ "$end" -le "$(date +%s)" ]; then
    echo "No session running."
    exit 0
  fi
  # The state file was last written when the session started. The screens
  # going dark is not sleep: only the system's own power log tells.
  start=$(stat -f %m "$STATE")
  slept=$(pmset -g log | awk -v s="$(date -r "$start" '+%Y-%m-%d %H:%M:%S')" \
    '/Entering Sleep state/ && $1 " " $2 >= s { n++ } END { print n + 0 }')
  [ "$slept" = 0 ] && slept="No sleep" || slept="Slept $slept time(s)"
  echo "Awake $(until_text "$end"). $slept since the session started at $(date -r "$start" '+%H:%M')."
  exit 0
fi

if [ "$arg" = noend ]; then
  end=$NOEND
elif [[ "$arg" =~ ^([1-9][0-9]*)(h|m)$ ]]; then
  n="${BASH_REMATCH[1]}"
  [ "${BASH_REMATCH[2]}" = h ] && secs=$((n * 3600)) || secs=$((n * 60))
  end=$(($(date +%s) + secs))
else
  echo "Usage: lidless [duration|noend|stop|status]   e.g. lidless 4h, lidless 90m" >&2
  exit 1
fi
# After the duration is read: low_battery reuses BASH_REMATCH.
if low_battery; then
  echo "Battery under $LOW %: plug the Mac in to start a session." >&2
  exit 1
fi

echo "$end" > "$STATE"
echo "Mac awake $(until_text "$end") (lid closed included). \"lidless stop\" to end it."
